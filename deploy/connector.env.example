# Portainer environment. No real credentials in this file.
DATA_DIR=/home/Docker
GOOGLE_MCP_IMAGE=gitea.lengoc.me/apps/google-drive-mcp:2.12.0-lnc.ui.20261017.4
# Choose bootstrap/runtime mode OR legacy GOOGLE_MCP_ADMIN_KEY_FILE, never both.
GOOGLE_MCP_ADMIN_BOOTSTRAP_KEY=
GOOGLE_MCP_ADMIN_KEY_STORE=/config/admin-key.json
GOOGLE_CONNECTOR_IMAGE=gitea.lengoc.me/apps/google-workspace-connector:1.0.0-lnc.20261016.1
# Preserve existing exact values; do not re-consent or rotate.
GOOGLE_MCP_SCOPES=drive,drive.file,drive.readonly,documents,spreadsheets,presentations,calendar,calendar.events,gmail.readonly,gmail.compose,gmail.settings.basic
MCP_HTTP_BEARER_TOKEN=
# Existing account alias in Google MCP; operator checks locally, never copy tokens.
GOOGLE_CONNECTOR_ACCOUNT=
# Copy matching pairing from DISABLED Hub managed connector via approved secret channel.
GOOGLE_CONNECTOR_PAIRING_TOKEN=
GOOGLE_CONNECTOR_DELEGATION_SECRET=
