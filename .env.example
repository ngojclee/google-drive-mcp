# DATA_DIR controls the host bind-mount root. Keep it aligned with the
# service-account path below: ${DATA_DIR}/google-analytics-connector/secrets/...
DATA_DIR=/home/Docker

# Hub pairing values: create the connector DISABLED in Business MCP /admin,
# then transfer the one-time-revealed values through the approved secret channel.
GA_MCP_BEARER_TOKEN=replace-with-managed-connector-bearer-at-least-32-characters
GA_HUB_DELEGATION_SECRET=replace-with-managed-delegation-secret-at-least-32-chars
GA_HUB_AUDIENCE=google-analytics

# Final externally-reachable TLS URL. The Hub requires valid HTTPS and an
# exact trusted certificate/SAN for this hostname.
GA_PRIVATE_MCP_URL=https://ga-mcp.example.internal/mcp
GA_ALLOWED_HOSTS=ga-mcp.example.internal
GA_HOST_PORT=3444

# Mount a read-only Google service-account JSON into the container. It must
# belong to a Google Cloud project with both Analytics Data and Admin APIs
# enabled and have Viewer/Analyst access to each required GA4 property.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-analytics-service-account.json
# Optional; used only by Google client libraries that require project context.
GOOGLE_PROJECT_ID=

# Required only for the local operator dashboard at /admin. This is separate
# from the Business MCP bearer/delegation pairing and Google service account.
MANAGEMENT_TOKEN=replace-with-dashboard-password-at-least-32-characters
